/* pages/common/float-nav.wxss —— 可拖动 / 点击翻面的模块导航球 */
.float-nav-ball {
  position: fixed;
  z-index: 30;
  width: 208rpx;
  height: 290rpx;
  perspective: 1600rpx;
  transition: width 0.3s ease, height 0.3s ease;
}
/* 翻转后展开成正常悬浮面板：字体与间距不再挤压 */
.float-nav-ball.is-open {
  width: 380rpx;
  height: 580rpx;
}
.float-nav-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1);
}
.float-nav-inner.is-flipped { transform: rotateY(180deg); }
.float-nav-face {
  position: absolute;
  inset: 0;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 2rpx solid #e2efe8;
  box-shadow: 0 10rpx 30rpx rgba(16, 38, 29, 0.16);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.float-nav-front {
  justify-content: center;
  padding: 18rpx 10rpx;
}
.float-nav-back {
  transform: rotateY(180deg);
  justify-content: flex-start;
  padding: 26rpx 22rpx;
}
.float-nav-ring-track {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.float-nav-ring-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 10rpx rgba(16, 38, 29, 0.05);
}
.float-nav-num { font-size: 42rpx; font-weight: 800; color: #0f8a5a; line-height: 1; }
.float-nav-unit { font-size: 18rpx; color: #5e7368; margin-top: 4rpx; }
.float-nav-current { margin-top: 16rpx; font-size: 24rpx; font-weight: 800; color: #14352a; }
.float-nav-tip { margin-top: 6rpx; font-size: 18rpx; color: #8ea196; }
.float-nav-back-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #14352a;
  margin-bottom: 20rpx;
}
.float-nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 80rpx;
  padding: 0 18rpx;
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  background: #f0f7f3;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.float-nav-item.active {
  background: #e4f1e9;
  border-color: #0f8a5a;
}
.float-nav-mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.float-nav-label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #5e7368;
  white-space: nowrap;
}
.float-nav-item.active .float-nav-label { color: #0f8a5a; }
.float-nav-check { font-size: 28rpx; font-weight: 800; color: #0f8a5a; }
