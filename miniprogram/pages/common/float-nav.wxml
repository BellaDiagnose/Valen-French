<!--pages/common/float-nav.wxml —— 共用模块导航悬浮球（法语页 / 科学页 include）-->
<!--正面：当前模块进度环；背面：首页 + 两本法语书 + 化学 + 生物-->
<view
  class="float-nav-ball {{floatFlipped ? 'is-open' : ''}}"
  style="left: {{floatX}}px; top: {{floatY}}px;"
  bindtouchstart="onFloatTouchStart"
  bindtouchmove="onFloatTouchMove"
  bindtouchend="onFloatTouchEnd"
>
  <view class="float-nav-inner {{floatFlipped ? 'is-flipped' : ''}}">
    <view class="float-nav-face float-nav-front">
      <view
        class="float-nav-ring-track"
        style="background: conic-gradient(#0f8a5a 0%, #22ac70 {{ringPercent}}%, #e8f1ec {{ringPercent}}%, #e8f1ec 100%)"
      >
        <view class="float-nav-ring-inner">
          <text class="float-nav-num">{{floatValue}}</text>
          <text class="float-nav-unit">{{floatUnit}}</text>
        </view>
      </view>
      <view class="float-nav-current">{{floatCurrentLabel}}</view>
      <view class="float-nav-tip">点击切换模块</view>
    </view>

    <view class="float-nav-face float-nav-back">
      <view class="float-nav-back-title">模块导航</view>
      <view
        wx:for="{{floatNavItems}}" wx:key="key"
        class="float-nav-item {{item.active ? 'active' : ''}}"
        data-key="{{item.key}}" catchtap="onFloatNavTap"
      >
        <text class="float-nav-mark" style="background: {{item.tint}}; color: {{item.accent}}">{{item.mark}}</text>
        <text class="float-nav-label">{{item.label}}</text>
        <text wx:if="{{item.active}}" class="float-nav-check">✓</text>
      </view>
    </view>
  </view>
</view>
