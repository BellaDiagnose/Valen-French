/* pages/french/french.wxss —— 中学生风格：清爽、专注、对比清晰 */
@import "../common/float-nav.wxss";
@import "../common/plan-panel.wxss";
@import "../common/recall.wxss";

.page {
  min-height: 100vh;
  background: #f2f8f4;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #10261d;
}

/* ============ 顶部 ============ */
.header {
  padding: 24rpx 8rpx 8rpx;
}

/* ============ Tab ============ */
.tabs {
  display: flex;
  background: #e3f0e9;
  border-radius: 26rpx;
  padding: 10rpx;
  margin: 20rpx 0 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 38, 29, 0.06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  color: #53675d;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}
.tab.active {
  background: #ffffff;
  color: #0f8a5a;
  box-shadow: 0 6rpx 16rpx rgba(15, 138, 90, 0.18);
}

/* ============ 通用面板 ============ */
.panel {
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============ 单词卡 ============ */
/* 课次筛选（简明法语） */
.lesson-picker {
  display: flex;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 20rpx;
  padding-bottom: 6rpx;
}
.lesson-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 88rpx;
  text-align: center;
  margin-right: 10rpx;
  color: #5e7368;
  background: #e6f1ea;
  border-radius: 14rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.lesson-chip-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}
.lesson-chip-count {
  font-size: 20rpx;
  line-height: 1.3;
  margin-top: 4rpx;
  opacity: 0.75;
}
.lesson-chip.active {
  color: #ffffff;
  background: #0f8a5a;
  box-shadow: 0 4rpx 12rpx rgba(15, 138, 90, 0.25);
}
.card-counter {
  text-align: center;
  font-size: 26rpx;
  color: #8ea196;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.flashcard {
  width: 100%;
  position: relative;
  perspective: 1600rpx;
  margin-bottom: 36rpx;
}
.face {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(16, 38, 29, 0.10);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.face-front {
  transform: rotateY(0deg);
  background: linear-gradient(160deg, #ffffff 0%, #f4fbf7 100%);
  justify-content: center;
  padding: 60rpx 40rpx 100rpx;
}
.face-back {
  transform: rotateY(180deg);
  background: linear-gradient(160deg, #edf7f1 0%, #ffffff 100%);
  overflow-y: auto;
  justify-content: flex-start;
  padding: 100rpx 36rpx 56rpx;
}
.flashcard.is-flipped .face-front { transform: rotateY(-180deg); }
.flashcard.is-flipped .face-back  { transform: rotateY(0deg); }

.card-lesson {
  position: absolute;
  top: 36rpx;
  left: 40rpx;
  font-size: 24rpx;
  color: #8ea196;
  background: #edf5f0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.word-fr {
  font-size: 68rpx;
  font-weight: 700;
  color: #14352a;
  text-align: center;
  line-height: 1.2;
}
.word-phonetic {
  font-size: 32rpx;
  color: #6b8075;
  margin-top: 20rpx;
  font-family: Georgia, serif;
}
.word-cn {
  font-size: 52rpx;
  font-weight: 700;
  color: #0f8a5a;
  text-align: center;
  margin-top: 16rpx;
  line-height: 1.35;
}
.example {
  margin-top: 40rpx;
  width: 100%;
  text-align: center;
  border-top: 2rpx solid #e2efe8;
  padding-top: 32rpx;
}
.example-fr {
  font-size: 30rpx;
  color: #2e4c41;
  line-height: 1.6;
  font-style: italic;
}
.example-cn {
  font-size: 26rpx;
  color: #8ea196;
  margin-top: 12rpx;
}
/* 翻转提示：正反面均固定在底部，留出充足边距不贴边 */
.flip-hint {
  position: absolute;
  bottom: 40rpx;
  left: 0; right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #b2c3b9;
  letter-spacing: 1rpx;
}
/* 背面提示：跟随内容流，与例句之间留白，且底部不贴边 */
.face-back .flip-hint {
  position: static;
  bottom: auto;
  margin-top: 40rpx;
  padding: 0 0 8rpx;
  flex-shrink: 0;
}

/* 卡片操作按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}
.btn-nav, .btn-master, .btn-outline, .btn-primary {
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 10rpx;
  box-sizing: border-box;
}
.btn-nav {
  flex: 1;
  background: #ffffff;
  color: #445d52;
  border: 2rpx solid #e2efe8;
}
.btn-master {
  flex: 1.2;
  background: #e4f1e9;
  color: #0f8a5a;
  border: 2rpx solid #cfe7d8;
}
.btn-master.mastered {
  background: #e7f7ef;
  color: #1f9d63;
  border-color: #c6ecd8;
}
.skip-unlearned {
  text-align: center;
  font-size: 26rpx;
  color: #5e7368;
  padding: 32rpx 0 8rpx;
}

/* ============ 自测 ============ */
.quiz-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.quiz-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f8a5a;
}
.quiz-reset {
  font-size: 26rpx;
  color: #8ea196;
  padding: 8rpx 20rpx;
  border: 2rpx solid #e2efe8;
  border-radius: 999rpx;
  background: #fff;
}
.quiz-question {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 30rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(16, 38, 29, 0.06);
}
.quiz-mode-tag {
  font-size: 24rpx;
  color: #8ea196;
  margin-bottom: 24rpx;
}
.quiz-word {
  font-size: 56rpx;
  font-weight: 700;
  color: #14352a;
  line-height: 1.3;
}
.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.option {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 30rpx 32rpx;
  font-size: 30rpx;
  color: #254237;
  border: 2rpx solid #e2efe8;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.15s ease;
}
.option:active { transform: scale(0.985); }
.option.opt-correct {
  background: #e7f7ef;
  border-color: #1f9d63;
  color: #147a4c;
  font-weight: 600;
}
.option.opt-wrong {
  background: #fdecec;
  border-color: #e05a5a;
  color: #c23b3b;
}
.option-mark {
  font-size: 32rpx;
  font-weight: 700;
}
.quiz-feedback {
  margin-top: 28rpx;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  text-align: center;
}
.fb-right { background: #e7f7ef; }
.fb-wrong { background: #fdecec; }
.fb-title { font-size: 30rpx; font-weight: 700; }
.fb-right .fb-title { color: #147a4c; }
.fb-wrong .fb-title { color: #c23b3b; }
.fb-detail { font-size: 28rpx; color: #5e7368; margin-top: 12rpx; }
.fb-example { font-size: 24rpx; color: #8ea196; margin-top: 8rpx; font-style: italic; }
.btn-primary {
  margin-top: 32rpx;
  background: #0f8a5a;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 138, 90, 0.22);
}

/* ============ 动词变位 ============ */
.verb-picker {
  white-space: nowrap;
  margin-bottom: 32rpx;
}
.verb-chip {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #445d52;
  font-weight: 600;
}
.verb-chip.active {
  background: #0f8a5a;
  border-color: #0f8a5a;
  color: #ffffff;
}

/* 时态切换 */
.tense-picker {
  white-space: nowrap;
  margin: -8rpx 0 24rpx;
}
.tense-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: #e4f1e9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #445d52;
}
.tense-chip.active {
  background: #0f8a5a;
  color: #ffffff;
}

.verb-head {
  text-align: center;
  margin-bottom: 32rpx;
}
.verb-name {
  font-size: 60rpx;
  font-weight: 700;
  color: #14352a;
}
.verb-cn {
  font-size: 30rpx;
  color: #445d52;
  margin-top: 8rpx;
}
.verb-group {
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 12rpx;
}
.verb-memory-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.verb-stage-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f8a5a;
  background: #e4f1e9;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.verb-next-due { font-size: 22rpx; color: #8ea196; }
.verb-rate-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.verb-rate-bar .btn-rate { flex: 1; }

.conj-table {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(16, 38, 29, 0.06);
  margin-bottom: 32rpx;
}
.conj-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #edf5f0;
  min-height: 96rpx;
}
.conj-row:last-child { border-bottom: none; }
.conj-header {
  background: #f4fbf7;
}
.conj-cell {
  flex: 1;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #254237;
}
.person-col {
  flex: 0.85;
  color: #6b8075;
  font-size: 27rpx;
  border-right: 2rpx solid #edf5f0;
}
.conj-header .conj-cell {
  font-size: 26rpx;
  color: #8ea196;
  font-weight: 600;
}
.form-col {
  font-weight: 600;
  color: #14352a;
}
.form-col.masked {
  color: #ccdcd2;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.verb-actions {
  display: flex;
  gap: 16rpx;
}
.btn-outline {
  flex: 1.2;
  background: #e4f1e9;
  color: #0f8a5a;
  border: 2rpx solid #cfe7d8;
}
.verb-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 24rpx;
}

/* 卡片正面：动词变位背诵入口（词形下方，正常流） */
.card-verb-link {
  margin-top: 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #22ac70;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #e4f1e9;
  border: 2rpx solid #cfe7d8;
  z-index: 10;
}
.card-verb-link:active { background: #dbeede; }
/* 动词卡背面：内嵌现在时变位表 */
.card-conj {
  width: 100%;
  margin: 20rpx 0 8rpx;
  padding: 18rpx 20rpx 14rpx;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.card-conj-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f8a5a;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}
.card-conj-row {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx;
  border-bottom: 2rpx solid #f0f7f3;
}
.card-conj-row:last-of-type { border-bottom: none; }
.card-conj-person {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #8ea196;
}
.card-conj-form {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #14352a;
}
.card-conj-more {
  margin-top: 12rpx;
  text-align: center;
  font-size: 23rpx;
  color: #22ac70;
  padding: 10rpx 0 4rpx;
}
.card-conj-more:active { color: #0f8a5a; }
/* 动词原形行 */
.verb-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 记忆曲线：进度脚注 / 阶段徽标 / 评分按钮 ============ */
.progress-foot {
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 16rpx;
  text-align: center;
}
.card-counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.review-tag {
  font-size: 22rpx;
  color: #ffffff;
  background: #e08a3c;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.browse-tag {
  font-size: 24rpx;
  color: #0f8a5a;
}
.stage-badge {
  text-align: center;
  font-size: 24rpx;
  color: #445d52;
  background: #e4f1e9;
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin: 0 auto 24rpx;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
}
/* 自测反馈例句译文 */
.fb-example-cn {
  font-size: 24rpx;
  color: #5e7368;
  margin-top: 6rpx;
}

/* 记住了 / 忘记了 */
.btn-rate {
  flex: 1;
  text-align: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 24rpx 6rpx;
  box-sizing: border-box;
}
.btn-remember {
  background: #1f9d63;
  color: #ffffff;
}
.btn-forget {
  background: #fdecec;
  color: #c23b3b;
  border: 2rpx solid #f5d0d0;
}
.rate-hint {
  text-align: center;
  font-size: 22rpx;
  color: #8ea196;
  margin-top: 20rpx;
}

/* ============ 复习计划面板 ============ */
/* 四卡 / 入口 / 清单样式在 common/plan-panel.wxss，与科学页共用；下面是法语独有的变位复习入口 */
.verb-review-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #14352a;
}
.verb-due-badge {
  font-size: 24rpx;
  color: #ffffff;
  background: #0f8a5a;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.verb-due-none { font-size: 24rpx; color: #8ea196; }

/* ============ 知识点速查 ============ */
.points-head { margin-bottom: 24rpx; }
.points-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #14352a;
}
.points-sub {
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 8rpx;
}
.unit-filter {
  white-space: nowrap;
  margin-bottom: 28rpx;
}
.unit-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5e7368;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 999rpx;
}
.unit-chip.active {
  color: #ffffff;
  background: #0f8a5a;
  border-color: #0f8a5a;
}
.point-group { margin-bottom: 32rpx; }
.point-group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f8a5a;
  padding: 14rpx 24rpx;
  background: #e4f1e9;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}
.point-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(16, 38, 29, 0.04);
}
.point-fr {
  font-size: 30rpx;
  font-weight: 600;
  color: #14352a;
}
.point-cn {
  font-size: 25rpx;
  color: #53675d;
  margin-top: 8rpx;
  line-height: 1.55;
}

/* ============ 强制自测关卡（模态层） ============ */
.force-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(16, 38, 29, 0.88);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.force-card {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}
.force-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}
.force-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14352a;
  margin-bottom: 16rpx;
}
.force-desc {
  font-size: 26rpx;
  color: #53675d;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.force-qword {
  font-size: 56rpx;
  font-weight: 700;
  color: #14352a;
  margin-bottom: 10rpx;
  line-height: 1.3;
}
.force-qhint {
  font-size: 24rpx;
  color: #8ea196;
  margin-bottom: 28rpx;
}
.force-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.force-option {
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: #f4fbf7;
  border: 2rpx solid #e2efe8;
  color: #254237;
}
.force-option.opt-correct {
  background: #e7f7ef;
  border-color: #1f9d63;
  color: #147a4c;
  font-weight: 600;
}
.force-option.opt-wrong {
  background: #fdecec;
  border-color: #e05a5a;
  color: #c23b3b;
}
.force-feedback {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.force-feedback.fb-right { background: #e7f7ef; color: #147a4c; }
.force-feedback.fb-wrong { background: #fdecec; color: #c23b3b; }
.force-next {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #0f8a5a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
.force-foot {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8ea196;
}

/* ============ 单元例句（知识点页） ============ */
.ex-block {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #fffaf2;
  border-radius: 14rpx;
  border-left: 6rpx solid #e0a458;
}
.ex-block-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #c98536;
  margin-bottom: 12rpx;
}
.ex-card {
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #f0e2cc;
}
.ex-fr {
  font-size: 28rpx;
  color: #2e4c41;
  font-style: italic;
  line-height: 1.5;
}
.ex-cn {
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 4rpx;
}
/* ============ 简明法语语法体系（知识点页） ============ */
.grammar-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(16, 38, 29, 0.04);
}
