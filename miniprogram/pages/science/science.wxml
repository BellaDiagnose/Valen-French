<!--pages/science/science.wxml —— 科学：七+八年级生物 / 八年级化学双语知识点 + 公式-->
<import src="../common/recall.wxml" />
<!-- 顶栏：home 圆钮 + 标题/科目名 + 进度环下拉（navigationStyle: custom） -->
<include src="../common/nav-bar.wxml" />
<view class="page" style="padding-top: {{navTotal}}px; min-height: calc(100vh - {{navTotal}}px);">

  <view class="tabs">
    <view
      wx:for="{{tabs}}" wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}" bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <!-- ========== 模块一：每日背诵（今日卡组） ========== -->
  <!-- 只放「今天该背的」：到期复习 + 今日额度内的新卡，评过即离场 -->
  <view wx:if="{{activeTab === 'point'}}" class="panel panel-fill">
    <!-- 章节切换：全部章节 + 各章短名与条数，选中即只在这一章里排卡 -->
    <scroll-view wx:if="{{!pointQueue}}" class="unit-picker" scroll-x enable-flex>
      <view
        wx:for="{{pointUnits}}" wx:key="key"
        class="unit-chip {{pointUnitFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="onPointUnit"
      >
        <view class="unit-chip-label">{{item.short}}</view>
        <view class="unit-chip-count">{{item.count}} 条</view>
      </view>
    </scroll-view>

    <view class="deck-head">
      <view class="deck-top">
        <view class="deck-title">{{subject === 'bio' ? '生物' : '化学'}} · {{pointUnitTitle || '今日背诵'}}</view>
        <view wx:if="{{pointTodayTotal}}" class="deck-frac">
          <text class="deck-frac-k">今日</text>
          <text class="deck-done-num">{{pointTodayDone}}</text>
          <text class="deck-total-num">/{{pointTodayTotal}}</text>
        </view>
      </view>
      <view wx:if="{{pointTodayTotal}}" class="deck-bar">
        <view class="deck-bar-fill" style="width: {{pointDeckPercent}}%"></view>
      </view>
      <view wx:if="{{point}}" class="deck-meta">
        <view wx:if="{{pointQueueLabel}}" class="queue-tag {{pointQueueTone === 'study' ? 'is-study' : ''}}" data-kind="point" bindtap="exitQueue">{{pointQueueLabel}} ✕</view>
        <view wx:else class="deck-breakdown">
          <text class="deck-k">到期</text><text class="deck-v">{{pointDeckDue}}</text>
          <text class="deck-dot">·</text>
          <text class="deck-k">新卡</text><text class="deck-v">{{pointDeckNew}}</text>
        </view>
        <view class="stage-pill">{{pointStageLabel}}</view>
      </view>
    </view>

    <view wx:if="{{point}}" class="flashcard {{pointFlipped ? 'is-flipped' : ''}}" bindtap="flipPoint">
      <view class="face face-front">
        <view class="card-tag">{{point.chapter}} · {{subject === 'bio' ? '生物' : '化学'}}</view>
        <view class="front-main">
          <view class="term-main {{pointLang === 'en' ? 'term-en' : ''}}">
            {{pointLang === 'en' ? point.en : point.cn}}
          </view>
          <view class="term-sub">{{pointLang === 'en' ? point.cn : point.en}}</view>
          <view class="front-def">{{pointLang === 'en' ? point.defEn : point.defCn}}</view>
        </view>
        <view class="front-meta">
          <text class="front-meta-key">{{point.keywords.length}} 个 LC 关键词</text>
          <text class="front-meta-dot">·</text>
          <text>LC 答题方法</text>
        </view>
        <view class="flip-hint">点击卡片查看{{pointLang === 'en' ? '中文' : '英文'}}定义 ↻</view>
      </view>
      <view class="face face-back">
        <view class="back-head">
          <view class="back-title">{{pointLang === 'en' ? point.cn : point.en}}</view>
          <view class="lang-btn" catchtap="togglePointLang">{{pointLang === 'en' ? '中 →' : 'EN →'}}</view>
        </view>
        <scroll-view class="back-body" scroll-y>
          <view class="def-block">
            <view class="def-label">{{pointLang === 'en' ? '中文解释' : 'Leaving Certificate Definition'}}</view>
            <view class="def-text">{{pointLang === 'en' ? point.defCn : point.defEn}}</view>
          </view>
          <view class="kw-block">
            <view class="def-label">LC 关键词 · Key terms</view>
            <view class="kw-list">
              <view wx:for="{{point.keywords}}" wx:key="en" class="kw-item">
                <text class="kw-en">{{item.en}}</text>
                <text class="kw-cn">{{item.cn}}</text>
              </view>
            </view>
          </view>
          <view class="tip-block">
            <view class="def-label">答题方法 · LC Exam tip</view>
            <view class="tip-text">{{point.lcTip}}</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{point}}" class="actions">
      <view class="btn-nav" bindtap="prevPoint">← 上一个</view>
      <view class="btn-rate btn-remember" data-delta="1" bindtap="ratePoint">记住了 ✓</view>
      <view class="btn-rate btn-forget" data-delta="-1" bindtap="ratePoint">忘记了 ↻</view>
      <view class="btn-nav" bindtap="nextPoint">下一个 →</view>
    </view>
    <view wx:if="{{point}}" class="rate-hint">记住了 → 隔更久再背；忘记了 → 明天重来｜评完自动下一张</view>

    <!-- 今日卡组清空 -->
    <view wx:if="{{!point}}" class="deck-empty">
      <view class="deck-empty-icon">✓</view>
      <view class="deck-empty-title">{{pointTodayDone ? '今天的卡片背完了' : (pointUnitTitle ? '本章没有待背卡片' : '今天没有要背的卡片')}}</view>
      <view wx:if="{{pointTodayDone}}" class="deck-empty-desc">今天共背 {{pointTodayDone}} 张 · 明天按 1→2→4→7 天间隔自动排卡</view>
      <view wx:else class="deck-empty-desc">{{pointUnitTitle ? '换一章看看，或点「全部章节」回到今日整组' : '这个科目已全部完成固化，想回顾去复习计划里翻'}}</view>
      <view class="btn-outline deck-empty-btn" bindtap="goPlan">看复习计划 →</view>
    </view>
  </view>

  <!-- ========== 模块二：公式卡 ========== -->
  <view wx:if="{{activeTab === 'formula'}}" class="panel panel-fill">
    <scroll-view wx:if="{{!formulaQueue}}" class="chip-row" scroll-x>
      <view
        wx:for="{{formulaUnits}}" wx:key="key"
        class="chip {{formulaUnitFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="onFormulaUnitFilter"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{formula}}" class="card-meta">
      <view wx:if="{{formulaQueueLabel}}" class="queue-tag {{formulaQueueTone === 'study' ? 'is-study' : ''}}" data-kind="formula" bindtap="exitQueue">{{formulaQueueLabel}} ✕</view>
      <view class="card-counter">{{formulaIndex + 1}} / {{formulaIds.length}}</view>
      <view class="stage-pill">{{formulaStageLabel}}</view>
    </view>

    <view wx:if="{{formula}}" class="flashcard formula-card {{formulaFlipped ? 'is-flipped' : ''}}" bindtap="flipFormula">
      <view class="face face-front">
        <view class="card-tag">{{formulaLang === 'en' ? formula.en : formula.cn}} · {{subject === 'bio' ? '生物' : '化学'}}</view>
        <view class="expr-main">{{formulaLang === 'en' ? formula.exprEn : formula.expr}}</view>
        <view wx:if="{{formula.formula}}" class="formula-line fs-{{formulaSize}}">
          <view wx:for="{{formulaRows}}" wx:for-item="row" wx:key="k" class="eq-row">
            <view wx:for="{{row.groups}}" wx:key="k" class="eq-group">
              <text wx:if="{{item.op}}" class="eq-op">{{item.op}}</text>
              <text class="eq-tok {{item.arrow ? 'eq-arrow' : ''}}">{{item.text}}</text>
            </view>
          </view>
        </view>
        <view class="flip-hint">点击卡片查看含义与考点 ↻</view>
      </view>
      <view class="face face-back">
        <view class="back-head">
          <view class="back-title">{{formulaLang === 'en' ? formula.cn : formula.en}}</view>
          <view class="lang-btn" catchtap="toggleFormulaLang">{{formulaLang === 'en' ? '中 →' : 'EN →'}}</view>
        </view>
        <scroll-view class="back-body" scroll-y>
          <view class="def-block">
            <view class="def-label">条件 · Condition</view>
            <view class="def-text">{{formulaLang === 'en' ? formula.condEn : formula.cond}}</view>
          </view>
          <view class="def-block">
            <view class="def-label">{{formulaLang === 'en' ? '中文说明' : 'LC 考点说明'}}</view>
            <view class="def-text">{{formulaLang === 'en' ? formula.noteCn : formula.noteEn}}</view>
          </view>
          <view class="kw-block">
            <view class="def-label">LC 关键词 · Key terms</view>
            <view class="kw-list">
              <view wx:for="{{formula.keywords}}" wx:key="en" class="kw-item">
                <text class="kw-en">{{item.en}}</text>
                <text class="kw-cn">{{item.cn}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{formula}}" class="actions">
      <view class="btn-nav" bindtap="prevFormula">← 上一个</view>
      <view class="btn-rate btn-remember" data-delta="1" bindtap="rateFormula">记住了 ✓</view>
      <view class="btn-rate btn-forget" data-delta="-1" bindtap="rateFormula">忘记了 ↻</view>
      <view class="btn-nav" bindtap="nextFormula">下一个 →</view>
    </view>
    <view wx:if="{{!formula}}" class="empty">该分类下暂无公式</view>
  </view>

  <!-- ========== 模块三：自测 ========== -->
  <view wx:if="{{activeTab === 'quiz'}}" class="panel">
    <view class="quiz-settings">
      <view class="setting-row">
        <text class="setting-label">方式</text>
        <view class="seg">
          <view class="seg-item {{quizWay === 'choice' ? 'active' : ''}}" data-key="choice" bindtap="onQuizWayChange">四选一</view>
          <view class="seg-item {{quizWay === 'recall' ? 'active' : ''}}" data-key="recall" bindtap="onQuizWayChange">默写</view>
        </view>
      </view>
      <view class="setting-row">
        <text class="setting-label">题目</text>
        <view class="seg">
          <view class="seg-item {{quizMode === 'point' ? 'active' : ''}}" data-key="point" bindtap="onQuizModeChange">术语互译</view>
          <view class="seg-item {{quizMode === 'formula' ? 'active' : ''}}" data-key="formula" bindtap="onQuizModeChange">公式配对</view>
        </view>
      </view>
      <view wx:if="{{quizWay === 'choice'}}" class="setting-row">
        <text class="setting-label">方向</text>
        <view class="seg">
          <view class="seg-item {{quizLang === 'en2zh' ? 'active' : ''}}" data-key="en2zh" bindtap="onQuizLangChange">英 → 中</view>
          <view class="seg-item {{quizLang === 'zh2en' ? 'active' : ''}}" data-key="zh2en" bindtap="onQuizLangChange">中 → 英</view>
        </view>
      </view>
    </view>

    <view class="quiz-meta">
      <view class="quiz-score">正确 {{quizRight}} / {{quizTotal}}</view>
      <view class="quiz-reset" bindtap="resetQuizStats">重置</view>
    </view>

    <!-- 四选一 -->
    <block wx:if="{{quizWay === 'choice'}}">
      <view wx:if="{{quiz}}" class="quiz-question">
        <view class="quiz-mode-tag">{{subject === 'bio' ? '生物' : '化学'}} · {{quizMode === 'point' ? '术语' : '公式'}}</view>
        <view class="quiz-word">{{quiz.answer.front}}</view>
        <view class="quiz-hint" wx:if="{{quiz.answer.hint}}">{{quiz.answer.hint}}</view>
        <view class="quiz-qhint">选出正确的{{quizLang === 'en2zh' ? '中文' : '英文'}}</view>
      </view>

    <view wx:if="{{quiz}}" class="options">
      <view
        wx:for="{{quiz.options}}" wx:key="id"
        class="option
          {{quizAnswered && item.id === quiz.answerId ? 'opt-correct' : ''}}
          {{quizAnswered && item.id === quizSelectedId && item.id !== quiz.answerId ? 'opt-wrong' : ''}}"
        data-id="{{item.id}}" bindtap="onSelectOption"
      >
        <text class="option-text">{{item.text}}</text>
        <text wx:if="{{quizAnswered && item.id === quiz.answerId}}" class="option-mark">✓</text>
      </view>
    </view>

    <view wx:if="{{quizAnswered}}" class="quiz-feedback {{quizCorrect ? 'fb-right' : 'fb-wrong'}}">
      {{quizCorrect ? '答对了 ✓' : '正确答案：' + quiz.answer.back}}
    </view>
    <view wx:if="{{quizAnswered}}" class="btn-primary quiz-next" bindtap="nextQuiz">下一题 →</view>
    </block>

    <!-- 默写 -->
    <block wx:if="{{quizWay === 'recall' && recall}}">
      <template is="recall" data="{{rl: recall}}" />
    </block>
  </view>

  <!-- ========== 模块四：复习计划 ========== -->
  <view wx:if="{{activeTab === 'plan'}}" class="panel plan-panel">
    <view class="plan-summary">
      <view class="stat-card stat-due"><view class="stat-num">{{planDueCount}}</view><view class="stat-label">今日待复习</view></view>
      <view class="stat-card stat-learning"><view class="stat-num">{{planLearningCount}}</view><view class="stat-label">学习中</view></view>
      <view class="stat-card stat-new"><view class="stat-num">{{planNewCount}}</view><view class="stat-label">新卡片</view></view>
      <view class="stat-card stat-grad"><view class="stat-num">{{planGraduatedCount}}</view><view class="stat-label">已固化</view></view>
    </view>

    <view class="plan-actions">
      <view class="btn-primary" bindtap="startTodayDeck">开始今日背诵{{planDeckCount ? '（' + planDeckCount + ' 张）' : ''}}</view>
    </view>

    <view wx:if="{{planFormulaDueCount}}" class="plan-entry" bindtap="startFormulaReview">
      <text>🧪 公式待复习</text>
      <text class="plan-entry-badge">{{planFormulaDueCount}} 条</text>
    </view>

    <view class="curve-note">
      <view class="curve-title">📈 智能学习计划</view>
      <view class="curve-desc">每天 {{planDailyCount}} 条新卡片，间隔 1→2→4→7→15→30→60 天复习；连续 {{planStreak}} 天。当前范围：{{planSubjectLabel}} · {{planPointCount}} 知识点 + {{planFormulaCount}} 公式 = {{planItemCount}} 条。</view>
    </view>

    <view wx:if="{{planDueCount > 0}}" class="word-group">
      <view class="group-title group-title-due">今日待复习 · {{planDueCount}}</view>
      <view
        wx:for="{{planDueItems}}" wx:key="gid" class="word-row"
        data-group="due" data-kind="{{item.kind}}" data-gid="{{item.gid}}" bindtap="onPlanItemTap"
      >
        <view class="row-main"><text class="row-fr">{{item.title}}</text><text class="row-cn">{{item.sub}}</text></view>
        <view class="row-stage">{{item.stageText}}</view>
      </view>
    </view>

    <view wx:if="{{planLearningCount > 0}}" class="word-group">
      <view class="group-title group-title-learning">学习中 · {{planLearningCount}}</view>
      <view
        wx:for="{{planLearningItems}}" wx:key="gid" class="word-row"
        data-group="learning" data-kind="{{item.kind}}" data-gid="{{item.gid}}" bindtap="onPlanItemTap"
      >
        <view class="row-main"><text class="row-fr">{{item.title}}</text><text class="row-cn">{{item.sub}}</text></view>
        <view class="row-stage">{{item.stageText}}</view>
      </view>
    </view>

    <view wx:if="{{planNewCount > 0}}" class="word-group">
      <view class="group-title group-title-new">新卡片 · {{planNewCount}}</view>
      <view
        wx:for="{{planNewItems}}" wx:key="gid" class="word-row"
        data-group="new" data-kind="{{item.kind}}" data-gid="{{item.gid}}" bindtap="onPlanItemTap"
      >
        <view class="row-main"><text class="row-fr">{{item.title}}</text><text class="row-cn">{{item.sub}}</text></view>
        <view class="row-stage">{{item.stageText}}</view>
      </view>
    </view>

    <view wx:if="{{planGraduatedCount > 0}}" class="word-group">
      <view class="group-title group-title-grad">已固化 🎓 · {{planGraduatedCount}}</view>
      <view
        wx:for="{{planGraduatedItems}}" wx:key="gid" class="word-row"
        data-group="graduated" data-kind="{{item.kind}}" data-gid="{{item.gid}}" bindtap="onPlanItemTap"
      >
        <view class="row-main"><text class="row-fr">{{item.title}}</text><text class="row-cn">{{item.sub}}</text></view>
        <view class="row-stage">{{item.stageText}}</view>
      </view>
    </view>

    <view class="plan-foot-tip">点清单里任一卡片，可直接从这张背起</view>
  </view>

</view>
