@import "../common/nav-bar.wxss";
/* pages/science/science.wxss —— 与法语页一致的爱尔兰绿医疗主题 */
@import "../common/plan-panel.wxss";
@import "../common/recall.wxss";

.page {
  min-height: 100vh;
  background: #f2f8f4;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #10261d;
  /* 卡片页要「卡片吃满、按钮贴底」，靠 flex 列撑满一屏 */
  display: flex;
  flex-direction: column;
}
.page > .panel { flex-shrink: 0; }

/* ============ Tab ============ */
.tabs {
  display: flex;
  background: #e3f0e9;
  border-radius: 26rpx;
  padding: 10rpx;
  margin: 20rpx 0 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 38, 29, 0.06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  color: #53675d;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}
.tab.active {
  background: #ffffff;
  color: #0f8a5a;
  box-shadow: 0 6rpx 16rpx rgba(15, 138, 90, 0.18);
}

/* ============ 通用面板 ============ */
.panel { animation: fadeIn 0.25s ease; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.empty {
  text-align: center;
  color: #8ea196;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* ============ 分类 chip ============ */
/* scroll-view 横向排列用 inline-block（enable-flex 会让内容整体溢出上边缘被裁切），
   容器高度写死 64rpx 与 chip 同高 */
.chip-row {
  white-space: nowrap;
  width: 100%;
  height: 64rpx;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  box-sizing: border-box;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  vertical-align: top;
  text-align: center;
  color: #5e7368;
  background: #e6f1ea;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.chip.active {
  color: #ffffff;
  background: #0f8a5a;
  box-shadow: 0 4rpx 12rpx rgba(15, 138, 90, 0.25);
}

/* ============ 章节切换 chip（同法语课次条） ============ */
.unit-picker {
  display: flex;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 20rpx;
  padding-bottom: 6rpx;
}
.unit-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 88rpx;
  padding: 0 16rpx;
  text-align: center;
  margin-right: 10rpx;
  color: #5e7368;
  background: #e6f1ea;
  border-radius: 14rpx;
  flex-shrink: 0;
}
.unit-chip-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}
.unit-chip-count {
  font-size: 20rpx;
  line-height: 1.3;
  margin-top: 4rpx;
  opacity: 0.75;
}
.unit-chip.active {
  color: #ffffff;
  background: #0f8a5a;
  box-shadow: 0 4rpx 12rpx rgba(15, 138, 90, 0.25);
}
/* 滚到右端时最后一张不要贴死屏幕边 */
.unit-chip:last-child {
  margin-right: 24rpx;
}

/* ============ 今日背诵卡头 ============ */
/* 三段：标题 + 今日进度 → 全宽进度条 → 到期/新卡 + 阶段。信息一行到底，不再单独占一行「剩余」 */
.deck-head {
  margin-bottom: 18rpx;
}
.deck-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.deck-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #14352a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.deck-frac {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.deck-frac-k {
  font-size: 22rpx;
  font-weight: 500;
  color: #7d9187;
  margin-right: 8rpx;
}
.deck-done-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f8a5a;
  line-height: 1;
  letter-spacing: -1rpx;
}
.deck-total-num {
  font-size: 22rpx;
  font-weight: 600;
  color: #8ea196;
  margin-left: 4rpx;
}
/* 今日进度条：铺满整行，空槽也要看得见 */
.deck-bar {
  margin-top: 14rpx;
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: #d5e8dd;
  overflow: hidden;
}
.deck-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3cbb84 0%, #0f8a5a 100%);
  transition: width 0.3s ease;
}
.deck-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  min-height: 40rpx;
}
.deck-breakdown {
  display: flex;
  align-items: baseline;
  font-size: 22rpx;
  color: #6b8075;
}
.deck-k {
  font-size: 22rpx;
  color: #7d9187;
  margin-right: 6rpx;
}
.deck-v {
  font-size: 26rpx;
  font-weight: 700;
  color: #14352a;
}
.deck-dot {
  margin: 0 14rpx;
  color: #c3d4c9;
}

/* 今日卡组清空 */
.deck-empty {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 14rpx 40rpx rgba(16, 38, 29, 0.08);
  text-align: center;
  min-height: 520rpx;
}
.deck-empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background: #e4f1e9;
  color: #0f8a5a;
  font-size: 60rpx;
  font-weight: 800;
  margin-bottom: 28rpx;
}
.deck-empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #14352a;
  margin-bottom: 14rpx;
}
.deck-empty-desc {
  font-size: 24rpx;
  color: #6b8075;
  line-height: 1.6;
  padding: 0 10rpx;
}
.deck-empty-btn {
  margin-top: 40rpx;
  width: 100%;
  max-width: 440rpx;
}

/* 计数与阶段靠左排 */
.card-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.card-counter {
  font-size: 24rpx;
  color: #8ea196;
  letter-spacing: 2rpx;
}
.stage-pill {
  font-size: 22rpx;
  color: #0d7a50;
  background: #e4f1e9;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ============ 翻卡 ============ */
/* 知识点 / 公式面板：卡片 flex 吃掉剩余高度，评分按钮固定在底部 */
.panel-fill {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.panel-fill .flashcard {
  flex: 1 1 auto;
  min-height: 520rpx;
  margin-bottom: 24rpx;
}
.panel-fill .actions {
  margin-top: auto;
}
.flashcard {
  width: 100%;
  position: relative;
  perspective: 1600rpx;
}
.face {
  position: absolute;
  inset: 0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(16, 38, 29, 0.10);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.face-front {
  transform: rotateY(0deg);
  background: linear-gradient(160deg, #ffffff 0%, #f4fbf7 100%);
  justify-content: center;
  align-items: center;
  padding: 60rpx 40rpx 100rpx;
}
.face-back {
  transform: rotateY(180deg);
  background: linear-gradient(160deg, #edf7f1 0%, #ffffff 100%);
  padding: 32rpx 30rpx 28rpx;
}
.flashcard.is-flipped .face-front { transform: rotateY(-180deg); }
.flashcard.is-flipped .face-back  { transform: rotateY(0deg); }

.card-tag {
  position: absolute;
  top: 30rpx;
  left: 32rpx;
  font-size: 22rpx;
  color: #6b8075;
  background: #e4f1e9;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  max-width: 82%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.term-main {
  font-size: 48rpx;
  font-weight: 800;
  color: #14352a;
  text-align: center;
  line-height: 1.35;
  padding: 0 10rpx;
}
/* 正面不再只有一行标题：中文术语下面补英文术语 + 背面内容摘要 */
.front-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.term-sub {
  margin-top: 20rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #128a80;
  font-family: Georgia, 'Times New Roman', serif;
  text-align: center;
}
/* 正面直接给出同语言定义：知识点是「读」的入口，翻面才看另一语言 + 关键词 + 考点 */
.front-def {
  width: 100%;
  margin-top: 28rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.72;
  color: #445d52;
  text-align: left;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}
.front-meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8ea196;
}
.front-meta-key {
  color: #0f8a5a;
  font-weight: 700;
}
.front-meta-dot {
  margin: 0 10rpx;
  opacity: 0.6;
}
.term-main.term-en {
  font-size: 42rpx;
  font-family: Georgia, 'Times New Roman', serif;
  color: #0f8a5a;
}
.expr-main {
  font-size: 34rpx;
  font-weight: 700;
  color: #14352a;
  text-align: center;
  line-height: 1.6;
  width: 100%;
}
/* 方程式：一行放得下就一行，放不下按箭头断成「反应物 →」/「生成物」。
   组内（+ 6O₂）不拆，组间才允许折行 */
.formula-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  max-width: 100%;
  margin-top: 28rpx;
  font-weight: 800;
  color: #0f8a5a;
  font-family: Georgia, 'Times New Roman', serif;
  line-height: 1.35;
}
.formula-line.fs-38 { font-size: 38rpx; }
.formula-line.fs-32 { font-size: 32rpx; }
.formula-line.fs-27 { font-size: 27rpx; }
.formula-line.fs-24 { font-size: 24rpx; }
.eq-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: baseline;
  gap: 4rpx 16rpx;
  max-width: 100%;
}
.eq-group {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex: 0 0 auto;
  white-space: nowrap;
}
.eq-tok {
  color: #0f8a5a;
}
.eq-op {
  color: #7d968a;
  font-weight: 700;
}
.eq-arrow {
  color: #7d968a;
}
.flip-hint {
  position: absolute;
  bottom: 30rpx;
  font-size: 24rpx;
  color: #8ea196;
}

/* ============ 卡背 ============ */
.back-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #d7e7dd;
  margin-bottom: 20rpx;
}
.back-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #14352a;
  line-height: 1.35;
}
.lang-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: #0f8a5a;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
}
.back-body {
  flex: 1;
  min-height: 0;
}
.def-block, .kw-block, .tip-block {
  margin-bottom: 24rpx;
}
.def-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f8a5a;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}
.def-text, .tip-text {
  font-size: 27rpx;
  line-height: 1.65;
  color: #2e4c41;
}
.tip-block {
  background: #e4f1e9;
  border-radius: 16rpx;
  padding: 20rpx;
}
.kw-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.kw-item {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 2rpx solid #d7e7dd;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  max-width: 100%;
}
.kw-en {
  font-size: 25rpx;
  font-weight: 700;
  color: #14352a;
}
.kw-cn {
  font-size: 21rpx;
  color: #6b8075;
  margin-top: 4rpx;
}

/* ============ 操作按钮（与法语页同一套尺寸） ============ */
.actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.btn-nav {
  flex: 1;
  padding: 24rpx 10rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #445d52;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 18rpx;
  box-sizing: border-box;
}
.btn-rate {
  flex: 1;
  padding: 24rpx 6rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 18rpx;
  box-sizing: border-box;
}
.btn-remember {
  color: #ffffff;
  background: #0f8a5a;
  box-shadow: 0 6rpx 16rpx rgba(15, 138, 90, 0.22);
}
.btn-forget {
  color: #b9683c;
  background: #f7ebe3;
}
.rate-hint {
  text-align: center;
  font-size: 22rpx;
  color: #8ea196;
  margin-top: 16rpx;
  line-height: 1.5;
}

/* ============ 自测 ============ */
.quiz-settings {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(16, 38, 29, 0.05);
}
.setting-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.setting-row + .setting-row {
  border-top: 2rpx solid #edf5f0;
}
.setting-label {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #53675d;
}
.quiz-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}
.quiz-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f8a5a;
}
.quiz-reset {
  font-size: 24rpx;
  color: #8ea196;
  padding: 8rpx 18rpx;
  background: #e6f1ea;
  border-radius: 12rpx;
}
.quiz-question {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 38, 29, 0.08);
}
.quiz-mode-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #0f8a5a;
  background: #e4f1e9;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}
.quiz-word {
  font-size: 42rpx;
  font-weight: 800;
  color: #14352a;
  line-height: 1.4;
}
.quiz-hint {
  font-size: 24rpx;
  color: #6b8075;
  margin-top: 16rpx;
  line-height: 1.5;
}
.quiz-qhint {
  font-size: 24rpx;
  color: #8ea196;
  margin-top: 20rpx;
}
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border: 2rpx solid #d7e7dd;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(16, 38, 29, 0.04);
}
.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #14352a;
  line-height: 1.45;
}
.option-mark {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f8a5a;
}
.opt-correct {
  border-color: #1f9d63;
  background: #e4f1e9;
}
.opt-wrong {
  border-color: #d9705f;
  background: #fbecea;
}
.quiz-feedback {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx;
  border-radius: 16rpx;
}
.fb-right { color: #1f9d63; background: #e4f1e9; }
.fb-wrong { color: #b9683c; background: #f7ebe3; }
.btn-primary {
  text-align: center;
  padding: 24rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: #0f8a5a;
  box-shadow: 0 6rpx 16rpx rgba(15, 138, 90, 0.22);
}
.quiz-next { margin-top: 24rpx; }

/* ============ 复习计划（样式见 common/plan-panel.wxss） ============ */
.btn-outline {
  text-align: center;
  padding: 24rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f8a5a;
  background: #e4f1e9;
  border: 2rpx solid #cfe7d8;
  box-sizing: border-box;
}
/* 科学条目是中英双语（中文术语 + 英文 / 公式），竖排避免长句挤压阶段标签 */
.plan-panel .row-main {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}
.plan-panel .row-fr,
.plan-panel .row-cn {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.plan-panel .row-cn {
  font-family: Georgia, 'Times New Roman', serif;
}
.plan-panel .row-stage {
  margin-left: 16rpx;
}
/* 队列模式标签：从计划进入卡片时提示「复习 / 新学 · N 条」 */
.queue-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: #0f8a5a;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.queue-tag.is-study { background: #d6a13c; }

/* 计划页：公式待复习入口（公式不参与每日卡组，单独入口） */
.plan-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 2rpx solid #e2efe8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #14352a;
}
.plan-entry-badge {
  font-size: 24rpx;
  color: #ffffff;
  background: #d6a13c;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.plan-foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #8ea196;
  padding: 20rpx 0 8rpx;
}
